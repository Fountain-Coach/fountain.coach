[Unit]
Description=Fountain Press HTTPS on the existing owner-WLAN staging release
After=network-online.target fountain-shell-acceptance-preview.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/benedikt/estate-shell-acceptance-staging/serve_shared_shell_preview_https.py --root /home/benedikt/estate-shell-acceptance-staging/current --bind 192.168.8.50 --port 8243 --cert /etc/teatro-first-readings-staging/fullchain.pem --key /etc/teatro-first-readings-staging/leaf.key
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
